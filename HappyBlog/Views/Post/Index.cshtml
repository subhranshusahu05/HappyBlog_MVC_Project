@using HappyBlog.Helpers
@model IEnumerable<HappyBlog.Models.Post>



@{
    ViewData["Title"] = "BolgPosts";
}

<div class="text-center m-3">
    @if (ViewBag.Categories != null)
    {

        @foreach (var category in ViewBag.Categories)
        {

            <a asp-controller="post" asp-action="Index" asp-route-categoryId="@category.Id"
               class="btn bg-warning text-decoration-none ms-2">@category.Name</a>
        }
    }
</div>




@if (User.IsInRole("Admin"))
{

    <div class="text-end my-2">
        <a class="btn btn-primary my-2" asp-action="Create" asp-controller="Post">Create New Post</a>
    </div>
}




<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    @foreach (var post in Model)
    {
        <div class="col">
            <div class="card bg-light border-dark h-100 border-2 shadow-lg rounded-1">
                <img src="@post.FeatureImagePath" class="card-img-top rounded-1" alt="@post.Title" style="height: 300px; object-fit: cover">

                <div class="card-body">
                    <h5 class="card-title">@post.Title</h5>
                    <p class="text-muted mb-2">Published on @post.PublishedDate.ToString(" MMM dd yyyy ")</p>

                    @{
                        var content = RemoveHtmlTagHelpers.RemoveHtmlTags(post.Content);
                    }

                    <p class="card-text">
                        @if (!string.IsNullOrEmpty(content))
                        {
                            if (content.Length > 100)
                            {
                                @content.Substring(0, 100)
                    
                                <text>...</text>
                            }
                            else
                            {
                                @content
                            }
                        }
                    </p>
                    <span class="badge bg-info text-dark mb-2">@post.Category.Name</span>
                </div>

                <div class="card-footer d-flex justify-content-between align-items-center">
                    <a class="btn btn-primary btn-sm " asp-controller="Post" asp-action="Detail" asp-route-id="@post.Id">ReadMore</a>
                    <div class="text-muted small">
                        By @post.Author
                    </div>
                </div>
            </div>
        </div>
    }
</div>
